<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime is required for Notarization on macOS 10.14.5+ -->

    <!-- Allow loading dynamic libraries — needed if we end up dlopen-ing CoreGraphics private symbols -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- Disable library validation: Apple's private CoreGraphics framework gets
         loaded at runtime; library validation rejects it. BetterDummy uses this
         entitlement; verify on Mac that we still need it given SwiftPM linkage. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow JIT — not strictly required for CLI but Electron child processes
         sometimes need it. Keep true to match parent app. -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Allow unsigned executable memory — not needed for our CLI -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>

    <!-- Disable executable page protection — not needed -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <false/>

    <!-- Network — virtual display creation is local OS API, no network needed -->
    <key>com.apple.security.network.client</key>
    <false/>
</dict>
</plist>
