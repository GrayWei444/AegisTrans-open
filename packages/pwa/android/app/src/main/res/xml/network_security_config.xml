<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 預設只允許 HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- AegisRD production endpoints（trans.aegisrd.com / api.aegisrd.com / mqtt.aegisrd.com） -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">aegisrd.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
