{
  "name": "aegis-trans-pwa",
  "version": "0.1.1",
  "description": "AegisTrans - 跨裝置自己對自己的訊息與檔案同步工具（從 AegisTalk codebase 演進）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-crypto-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-crypto-wasm.mjs",
    "build": "tsc -b && vite build",
    "prebuild:debug": "node scripts/ensure-crypto-wasm.mjs",
    "build:debug": "tsc -b && vite build --mode debug",
    "build:crypto": "bash ../crypto-core/build.sh --install",
    "preview": "vite preview",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:run": "npx cap run android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:run": "npx cap run ios"
  },
  "dependencies": {
    "@aegisrd/capacitor-aegisdisplay": "file:../aegis-display",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "hash-wasm": "^4.12.0",
    "idb": "^7.1.0",
    "jeep-sqlite": "^2.8.0",
    "mqtt": "^5.3.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.4.530",
    "qrcode": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "sql.js": "1.11.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@types/node": "^20.19.29",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
