<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Phase 2 §6.3: Hardened Runtime entitlements for Mac .dmg signed build -->

  <!-- Allow JIT for V8 / WebRTC -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Allow unsigned executable memory (some Capacitor plugins need this) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading unsigned dylibs (Electron bundled binaries) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Phase 2: Screen recording entitlement for getDisplayMedia / future AegisDisplay native impl
       Note: macOS still prompts user for screen recording permission on first use(System Settings → Privacy & Security → Screen Recording).
       Entitlement just declares the intent;不 bypass user consent. -->
  <key>com.apple.security.device.screen-capture</key>
  <true/>

  <!-- Phase 2/3: Microphone(future, for screen sharing with audio) -->
  <key>com.apple.security.device.audio-input</key>
  <false/>

  <!-- Network client(MQTT WebSocket + WebRTC + API calls) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Network server(WebRTC P2P incoming connections) -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- File access for user-selected files(transfer / share) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
