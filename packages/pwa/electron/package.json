{
  "name": "aegistrans-electron",
  "productName": "AegisTrans",
  "desktopName": "AegisTrans",
  "version": "0.1.0",
  "description": "AegisTrans 桌面版 — 跨裝置自己對自己的訊息與檔案同步工具(Capacitor Electron 殼)",
  "author": {
    "name": "AegisRD",
    "email": "hi@aegisrd.com"
  },
  "license": "MIT",
  "private": true,
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && electron-rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json -p always",
    "electron:appimage": "npm run build && electron-builder build --linux AppImage -c ./electron-builder.config.json"
  },
  "dependencies": {
    "@aegisrd/capacitor-aegisdisplay-electron": "file:../../aegis-display/electron",
    "@capacitor-community/electron": "^5.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "better-sqlite3-multiple-ciphers": "^12.0.0",
    "chokidar": "~3.5.3",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "~2.0.0",
    "electron-json-storage": "^4.6.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "node-fetch": "^2.7.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "@electron/rebuild": "^4.0.0",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron",
    "aegistrans",
    "aegisrd"
  ]
}
