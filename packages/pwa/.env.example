# AegisTrans PWA build settings. Copy to `.env.local` (git-ignored) and fill in.
# Everything is optional: with nothing set, the app connects to the official
# AegisTrans service (src/config/official-server.json) and users can switch to
# their own server at runtime in Settings or on the sign-in screen.

# ---- Default server for a self-hosted build ---------------------------------
# Setting VITE_DEFAULT_API_URL replaces the official defaults completely.
# The API serves /aegistrans/* (see api/README.md).
VITE_DEFAULT_API_URL=
# Web build only: same-origin path that your reverse proxy forwards to the API
# (e.g. /api). Leave empty to call VITE_DEFAULT_API_URL directly (needs CORS).
VITE_DEFAULT_WEB_API_PATH=
# MQTT over WebSocket, e.g. wss://mqtt.example.com/mqtt
VITE_DEFAULT_MQTT_URL=
# Optional: turn:host:port — only used to derive a STUN server (no relaying).
VITE_DEFAULT_TURN_URL=
# Optional: where users open the web app on a new device (shown in the UI).
VITE_DEFAULT_WEB_URL=
VITE_DEFAULT_SERVER_NAME=
VITE_DEFAULT_PRIVACY_URL=
VITE_DEFAULT_TERMS_URL=
VITE_DEFAULT_SUPPORT_URL=

# ---- Developer tools ---------------------------------------------------------
# '1' exposes debug hooks (window.__aegis*) — never set for a public release.
VITE_DEBUG_TOOLS=
# Remote console logging for dogfood builds (only with VITE_DEBUG_TOOLS=1).
VITE_REMOTE_DEBUG_MQTT_URL=
VITE_REMOTE_DEBUG_TOKEN_URL=
VITE_REMOTE_DEBUG_SAME_ORIGIN_TOKEN_PATH=
VITE_REMOTE_DEBUG_SAME_ORIGIN_MATCH=
