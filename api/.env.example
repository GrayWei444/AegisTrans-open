# AegisTrans standalone API (api/app.py). Copy to api/.env and fill in.
# Generate secrets with:  openssl rand -hex 32

# ---- Required ---------------------------------------------------------------
# Signs session tokens (HS256). At least 32 characters.
AEGISTRANS_JWT_SECRET=
# Signs MQTT tokens; the EMQX broker must verify with the SAME value. At least 32
# characters and different from AEGISTRANS_JWT_SECRET.
AEGIS_MQTT_JWT_SECRET=
# SQLite database file (created on first start; tables are prefixed aegistrans_).
AEGIS_DB_PATH=/data/aegistrans.db
# Public URL of the web app. E-mail verification links point to {APP_URL}/auth/verify.
AEGISTRANS_APP_URL=https://trans.example.com
# Sender of verification e-mails.
AEGISTRANS_MAIL_FROM=AegisTrans <noreply@example.com>
# Broker URL handed to clients by GET /aegistrans/auth/server-config (wss://, or ws://localhost for dev).
AEGISTRANS_PUBLIC_MQTT_URL=wss://mqtt.example.com/mqtt

# ---- E-mail (SMTP) ----------------------------------------------------------
AEGISTRANS_SMTP_HOST=127.0.0.1
AEGISTRANS_SMTP_PORT=25
# 1 = STARTTLS after connecting
AEGISTRANS_SMTP_STARTTLS=0
AEGISTRANS_SMTP_USERNAME=
AEGISTRANS_SMTP_PASSWORD=
# Optional; default to the address in MAIL_FROM / the app URL.
AEGISTRANS_MAIL_REPLY_TO=
AEGISTRANS_MAIL_MSGID_DOMAIN=
AEGISTRANS_MAIL_FOOTER_URL=

# ---- What clients see when they switch to this server -----------------------
# Optional: turn:host:port — clients only derive a STUN server from it (no relaying).
AEGISTRANS_PUBLIC_TURN_URL=
# Optional, comma-separated stun: URLs. Empty = clients use public STUN servers.
AEGISTRANS_PUBLIC_STUN_URLS=
AEGISTRANS_SERVER_NAME=
AEGISTRANS_PRIVACY_URL=
AEGISTRANS_TERMS_URL=
AEGISTRANS_SUPPORT_URL=
# Extra browser origins allowed by CORS (comma-separated). The app URL origin and the
# Android/iOS/desktop app shells are always allowed. Add e.g. the origin of another
# web deployment whose users should be able to pick this server.
AEGISTRANS_CORS_ORIGINS=

# ---- Development only ---------------------------------------------------------
# 1 enables POST /aegistrans/subscription/dev-set-tier for the admin e-mails below.
AEGISTRANS_DEV_MODE=0
AEGISTRANS_DEV_ADMIN_EMAILS=

# ---- In-app purchases (optional; leave empty to disable) ----------------------
# Purchase verification endpoints return 503 until these are set.
AEGISTRANS_IAP_BUNDLE_ID=
AEGISTRANS_IAP_APP_APPLE_ID=
# Product ids are {PREFIX}.monthly / .yearly / .lifetime
AEGISTRANS_IAP_PRODUCT_PREFIX=
# Directory with Apple root CA certificates (*.cer / *.der)
AEGISTRANS_APPLE_ROOT_DIR=
IAP_ALLOW_SANDBOX=
IAP_SANDBOX_USER_IDS=
AEGISTRANS_GOOGLE_PLAY_PACKAGE=
AEGISTRANS_GOOGLE_SERVICE_ACCOUNT_FILE=
AEGISTRANS_GOOGLE_PUBSUB_AUDIENCE=
AEGISTRANS_GOOGLE_PUBSUB_SERVICE_ACCOUNT=
